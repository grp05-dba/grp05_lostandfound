{
  "info": {
    "name": "PUP-SPOT local API checks",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Read-only local API checks. Requires the project database and seed data. No gateway calls or SMS sends."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "categoryId",
      "value": "1"
    },
    {
      "key": "missingCategoryId",
      "value": "999999"
    }
  ],
  "item": [
    {
      "name": "README health check",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/admin/test"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"JSON response\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); pm.expect(pm.response.json()).to.have.property('message', 'its working! :D'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "List items",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/admin/items"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"JSON response\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); pm.expect(pm.response.json()).to.be.an('array'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "List categories",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/public/categories"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"JSON response\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); pm.expect(pm.response.json()).to.be.an('array'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Get a category",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/public/categories/{{categoryId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"JSON response\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); pm.expect(pm.response.json()).to.have.property('category_id', Number(pm.collectionVariables.get('categoryId'))); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Missing category",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/public/categories/{{missingCategoryId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", function () { pm.response.to.have.status(404); });",
              "pm.test(\"JSON response\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); pm.expect(pm.response.json()).to.have.property('error', 'Category not found'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Invalid category ID",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/public/categories/not-a-number"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", function () { pm.response.to.have.status(404); });",
              "pm.test(\"JSON response\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); pm.expect(pm.response.json()).to.have.property('error'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Unknown endpoint",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/admin/not-an-endpoint"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", function () { pm.response.to.have.status(404); });",
              "pm.test(\"JSON response\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); pm.expect(pm.response.json()).to.have.property('error'); });"
            ]
          }
        }
      ]
    }
  ]
}
